# Optional: configure an OpenAI-compatible chat-completions API for AI-generated drafts.
# Without these values, Handoff uses its built-in local smart-draft fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional production settings
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# FLASK_DEBUG=0
# PORT=5000
